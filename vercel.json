{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/HTML/index.html" },
    { "source": "/dashboard", "destination": "/HTML/index.html" },
    { "source": "/tasks", "destination": "/HTML/index.html" },
    { "source": "/projects", "destination": "/HTML/index.html" },
    { "source": "/schedule", "destination": "/HTML/index.html" },
    { "source": "/meetings", "destination": "/HTML/index.html" },
    { "source": "/clients", "destination": "/HTML/index.html" },
    { "source": "/finance", "destination": "/HTML/index.html" },
    { "source": "/invoices", "destination": "/HTML/index.html" },
    { "source": "/services", "destination": "/HTML/index.html" },
    { "source": "/support", "destination": "/HTML/index.html" },
    { "source": "/team", "destination": "/HTML/index.html" },
    { "source": "/timetracker", "destination": "/HTML/index.html" },
    { "source": "/goals", "destination": "/HTML/index.html" },
    { "source": "/settings", "destination": "/HTML/index.html" },
    { "source": "/reports", "destination": "/HTML/index.html" },
    { "source": "/vault", "destination": "/HTML/index.html" },
    { "source": "/store/:username", "destination": "/HTML/store.html?u=:username" },
    { "source": "/portal/:token", "destination": "/HTML/client-portal.html?token=:token" },
    { "source": "/proposal/:token", "destination": "/HTML/proposal.html?token=:token" },
    { "source": "/review/:token", "destination": "/HTML/review.html?token=:token" },
    { "source": "/reviews/:username", "destination": "/HTML/reviews-public.html?u=:username" },
    { "source": "/admin", "destination": "/HTML/admin.html" },
    { "source": "/admin/", "destination": "/HTML/admin.html" },
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
