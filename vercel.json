{
  "version": 2,
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/client-portal.html", "destination": "/HTML/client-portal.html", "permanent": true },
    { "source": "/contract.html", "destination": "/HTML/contract.html", "permanent": true },
    { "source": "/proposal.html", "destination": "/HTML/proposal.html", "permanent": true },
    { "source": "/review.html", "destination": "/HTML/review.html", "permanent": true },
    { "source": "/reviews-public.html", "destination": "/HTML/reviews-public.html", "permanent": true },
    { "source": "/store.html", "destination": "/HTML/store.html", "permanent": true },
    { "source": "/team.html", "destination": "/HTML/team.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/HTML/landing.html" },
    { "source": "/home", "destination": "/HTML/landing.html" },
    { "source": "/dashboard", "destination": "/HTML/index.html" },
    { "source": "/tasks", "destination": "/HTML/index.html" },
    { "source": "/projects", "destination": "/HTML/index.html" },
    { "source": "/workflow-board", "destination": "/HTML/index.html" },
    { "source": "/schedule", "destination": "/HTML/index.html" },
    { "source": "/meetings", "destination": "/HTML/index.html" },
    { "source": "/clients", "destination": "/HTML/index.html" },
    { "source": "/finance", "destination": "/HTML/index.html" },
    { "source": "/invoices", "destination": "/HTML/index.html" },
    { "source": "/services", "destination": "/HTML/index.html" },
    { "source": "/support", "destination": "/HTML/index.html" },
    { "source": "/team", "destination": "/HTML/index.html" },
    { "source": "/timetracker", "destination": "/HTML/index.html" },
    { "source": "/goals", "destination": "/HTML/index.html" },
    { "source": "/settings", "destination": "/HTML/index.html" },
    { "source": "/reports", "destination": "/HTML/index.html" },
    { "source": "/vault", "destination": "/HTML/index.html" },
    { "source": "/reviews", "destination": "/HTML/index.html" },
    { "source": "/store", "destination": "/HTML/store.html" },
    { "source": "/store/:username", "destination": "/HTML/store.html?u=:username" },
    { "source": "/portal/:token", "destination": "/HTML/client-portal.html?token=:token" },
    { "source": "/brief/:username/:token/:formId", "destination": "/HTML/brief.html?u=:username&t=:token&f=:formId" },
    { "source": "/brief/:username/:token", "destination": "/HTML/brief.html?u=:username&t=:token" },
    { "source": "/proposal/:token", "destination": "/HTML/proposal.html?token=:token" },
    { "source": "/review/:token", "destination": "/HTML/review.html?token=:token" },
    { "source": "/public-reviews", "destination": "/HTML/reviews-public.html" },
    { "source": "/reviews/:username", "destination": "/HTML/reviews-public.html?u=:username" },
    { "source": "/privacy", "destination": "/HTML/privacy.html" },
    { "source": "/terms", "destination": "/HTML/terms.html" },
    { "source": "/admin", "destination": "/HTML/admin.html" },
    { "source": "/admin/", "destination": "/HTML/admin.html" },
    { "source": "/error", "destination": "/HTML/error.html" },
    { "source": "/404", "destination": "/HTML/error.html?code=404" },
    { "source": "/500", "destination": "/HTML/error.html?code=500" },
    { "source": "/505", "destination": "/HTML/error.html?code=505" },
    { "source": "/api/:path*", "destination": "/api/index.js" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/Assets/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/JavaScript/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=3600" }] },
    { "source": "/CSS/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=3600" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/admin/", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/HTML/admin.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/portal/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/HTML/client-portal.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/review/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/public-reviews", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/reviews/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/HTML/review.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] },
    { "source": "/HTML/reviews-public.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }] }
  ]
}
